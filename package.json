  "maintainers": [
    {
      "name": "Rajat Malik",
      "email": "mr.rajatmalik@gmail.com"
    }
  ],
  "homepage": "https://github.com/malikrajat/rm-image-slider#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/malikrajat/rm-image-slider.git"
  },
  "bugs": {
    "url": "https://github.com/malikrajat/rm-image-slider/issues",
    "email": "mr.rajatmalik@gmail.com"
