    "auto slide",
    "infinite scroll",
    "responsive images",
    "mobile responsive",
    "touch support",
    "gallery lightbox",
    "image popup",
    "video popup",
    "ng-lightbox",
    "angular lightbox",
    "carousel component",
    "slider component",
    "angular component",
    "ng-carousel",
    "image viewer",
    "media slider",
    "media gallery",
