{
  "name": "rm-image-slider",
  "version": "22.0.0",
  "description": "Angular image slider and carousel component with lightbox popup, video support (YouTube MP4), touch gestures, lazy loading, responsive design, and accessibility (WCAG). Lightweight, standalone, tree-shakable Angular library.",
  "license": "MIT",
  "keywords": [
