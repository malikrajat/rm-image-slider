  "peerDependencies": {
    "@angular/core": "^20.0.0 || ^26.0.0",
    "@angular/common": "^20.0.0 || ^26.0.0"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  },
  "dependencies": {
    "tslib": "^2.6.0"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "funding": {
    "type": "individual",
    "url": "https://github.com/sponsors/malikrajat"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "ng-add": {
    "save": "dependencies"
  },
  "ng-update": {
    "packageGroup": [
      "rm-image-slider"
    ]
  },
  "directories": {
    "lib": "./src",
    "doc": "./docs"
  },
  "packageManager": "pnpm@10.11.1",
  "type": "module",
  "private": false,
  "readme": "README.md",
  "module": "fesm2022/rm-image-slider.mjs",
  "typings": "types/rm-image-slider.d.ts",
  "exports": {
    "./package.json": {
      "default": "./package.json"
    },
    ".": {
      "types": "./types/rm-image-slider.d.ts",
      "default": "./fesm2022/rm-image-slider.mjs"
    }
  }
}